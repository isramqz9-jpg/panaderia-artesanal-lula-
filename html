
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>LULA | Panadería Artesanal</title>

    <meta name="description" content="Descubre LULA Panadería Artesanal. Pan dulce, postres y pequeños detalles hechos con cariño.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="styles.css">
</head>

<body>

    <!-- BARRA SUPERIOR -->
    <div class="barra-superior">
        Hecho con cariño, pensado para compartir ♡
    </div>

    <!-- ENCABEZADO -->
    <header class="encabezado">

        <a href="#inicio" class="logo">
            <span class="logo-letra">L</span>
            <span>
                <strong>LULA</strong>
                <small>panadería artesanal</small>
            </span>
        </a>

        <button class="menu-boton" id="menuBoton" aria-label="Abrir menú">
            ☰
        </button>

        <nav class="navegacion" id="navegacion">
            <a href="#inicio">Inicio</a>
            <a href="#nosotros">Nosotros</a>
            <a href="#productos">Productos</a>
            <a href="#galeria">Galería</a>
            <a href="#contacto">Contacto</a>
        </nav>

        <a href="#productos" class="boton-encabezado">
            Ver antojitos ↗
        </a>

    </header>

    <main>

        <!-- PORTADA -->
        <section class="portada" id="inicio">

            <div class="portada-texto">

                <p class="etiqueta">♡ UN DETALLE DULCE PARA TU DÍA</p>

                <h1>
                    Lo artesanal<br>
                    se siente en<br>
                    <em>cada bocado.</em>
                </h1>

                <p class="descripcion-portada">
                    Bienvenido a LULA, un rinconcito donde los sabores,
                    los detalles y el cariño se convierten en momentos
                    para disfrutar y compartir.
                </p>

                <div class="botones-portada">
                    <a href="#productos" class="boton boton-oscuro">
                        Descubre nuestros productos ↗
                    </a>
                </div>

                <p class="nota-portada">
                    ♡ Pequeños antojos, grandes momentos.
                </p>

            </div>

            <div class="portada-imagen">
                <img
                    src="https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=1000&q=85"
                    alt="Pan artesanal recién horneado"
                >

                <div class="sello">
                    <span>♡</span>
                    <small>HECHO CON<br>AMOR</small>
                </div>
            </div>

        </section>

        <!-- NOSOTROS -->
        <section class="nosotros seccion" id="nosotros">

            <p class="etiqueta">CONOCE NUESTRA ESENCIA</p>

            <h2>
                Más que un antojo,<br>
                <em>un momento especial.</em>
            </h2>

            <p>
                En LULA creemos que las cosas sencillas pueden hacer
                especiales nuestros días. Nos inspira la panadería
                artesanal, el gusto por los pequeños detalles y la
                alegría de compartir algo delicioso con las personas
                que queremos.
            </p>

            <p>
                Queremos acompañarte en tus mañanas, tus reuniones,
                tus celebraciones y esos momentos en los que simplemente
                se te antoja algo rico.
            </p>

            <a
                href="https://instagram.com/lula.panaderiaartesanal"
                target="_blank"
                rel="noopener noreferrer"
                class="enlace"
            >
                Conoce más de LULA en Instagram ↗
            </a>

        </section>

        <!-- PRODUCTOS -->
        <section class="productos" id="productos">

            <div class="seccion">

                <p class="etiqueta">PREPARADOS PARA ANTOJARTE</p>

                <h2>Nuestros <em>favoritos</em></h2>

                <p class="subtitulo">
                    Encuentra tu próximo antojo y agrégalo a tu pedido.
                </p>

                <div class="rejilla-productos" id="rejillaProductos">
                    <!-- Los productos se mostrarán desde app.js -->
                </div>

                <p class="aviso-productos">
                    Los productos y precios de ejemplo deben actualizarse
                    con el menú real de LULA.
                </p>

            </div>

        </section>

        <!-- FRASE -->
        <section class="frase">
            <span class="corazon">♡</span>

            <h2>
                Las cosas hechas con cariño<br>
                siempre saben un poquito mejor.
            </h2>

            <p>LULA · PANADERÍA ARTESANAL</p>
        </section>

        <!-- GALERÍA -->
        <section class="seccion galeria" id="galeria">

            <p class="etiqueta">UN VISTAZO A NUESTRO MUNDO</p>

            <h2>Momentos <em>LULA</em></h2>

            <div class="rejilla-galeria">

                <img
                    src="https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=900&q=85"
                    alt="Panadería artesanal"
                    loading="lazy"
                >

                <img
                    src="https://images.unsplash.com/photo-1486427944299-d1955d23e34d?auto=format&fit=crop&w=900&q=85"
                    alt="Pastelitos dulces"
                    loading="lazy"
                >

                <img
                    src="https://images.unsplash.com/photo-1550617931-e17a7b70dce2?auto=format&fit=crop&w=900&q=85"
                    alt="Repostería para compartir"
                    loading="lazy"
                >

            </div>

            <a
                href="https://instagram.com/lula.panaderiaartesanal"
                target="_blank"
                rel="noopener noreferrer"
                class="enlace"
            >
                Síguenos en @lula.panaderiaartesanal ↗
            </a>

        </section>

        <!-- CONTACTO -->
        <section class="contacto" id="contacto">

            <div class="contacto-contenido">

                <div>
                    <p class="etiqueta">¿SE TE ANTOJÓ?</p>

                    <h2>
                        Hagamos tu día<br>
                        un poquito más <em>dulce.</em>
                    </h2>

                    <p>
                        Escríbenos para consultar nuestros productos,
                        disponibilidad y pedidos especiales.
                    </p>
                </div>

                <div class="contacto-botones">

                    <a
                        href="https://instagram.com/lula.panaderiaartesanal"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="boton boton-claro"
                    >
                        Visitar Instagram ↗
                    </a>

                    <a
                        href="#productos"
                        class="enlace enlace-claro"
                    >
                        Armar mi pedido ↑
                    </a>

                </div>

            </div>

        </section>

    </main>

    <!-- PIE DE PÁGINA -->
    <footer class="pie">

        <a href="#inicio" class="logo">
            <span class="logo-letra">L</span>
            <span>
                <strong>LULA</strong>
                <small>panadería artesanal</small>
            </span>
        </a>

        <p>Hecho con cariño, para compartir. ♡</p>

        <p>© <span id="anio"></span> LULA</p>

    </footer>

    <!-- CARRITO -->
    <aside class="carrito" id="carrito" aria-live="polite">

        <div class="carrito-texto">
            <strong>Tu pedido ♡</strong>
            <span id="resumenCarrito">Aún no agregas productos.</span>
        </div>

        <button
            class="boton boton-oscuro"
            id="enviarPedido"
            disabled
        >
            Pedir por WhatsApp ↗
        </button>

    </aside>

    <script src="app.js"></script>

</body>
</html>
